# The rack panel kiosk: cage (Wayland kiosk compositor) and Chromium on the inference host's 1424 x 280
# touch display. A system unit, because cage needs a logind session on tty1 (PAMName=login).
# deploy/panel/install-kiosk fills in the user, the home, the uid, the launcher's directory, the page
# URL and the paths of cage and Chromium, and installs it to /etc/systemd/system. The launcher (kiln-panel-browser) puts Chromium in a
# user scope with memory and CPU limits: processes here land in the logind session scope, where this
# unit's own resource settings would not apply.
[Unit]
Description=Kiln panel kiosk on the rack touch display (cage + chromium, tty1)
After=systemd-user-sessions.service network-online.target getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# Software rendering only: the panel never touches the GPU that inference uses.
Environment=WLR_RENDERER=pixman
# The touchscreen also reports itself as a mouse, so cage draws its default cursor until a pointer
# event gives Chromium focus, and touch never does. A theme of transparent cursors hides it.
Environment=XCURSOR_PATH=@HOME@/.local/share/kiln-panel/cursors
Environment=XCURSOR_THEME=default
Environment=XCURSOR_SIZE=24
# For ExecStopPost's `systemctl --user` (pam_systemd sets the same for the session).
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
# The page the kiosk opens, and the browser (kiln-panel-browser).
Environment=KILN_PANEL_URL=@URL@
Environment=KILN_PANEL_CHROMIUM=@CHROMIUM@
# Children inherit these: the panel yields CPU and disk to the engines and is the first to go under
# global memory pressure.
Nice=10
IOSchedulingClass=idle
# 300 is the lowest score Chromium gives a renderer, so it never tries (and fails) to lower one.
OOMScoreAdjust=300
ExecStart=@CAGE@ -s -d -- @BIN@/kiln-panel-browser
# Chromium lives in a user scope, outside this unit: stopping the kiosk must stop it too.
ExecStopPost=-/usr/bin/systemctl --user stop kiln-panel-chromium.scope
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
